# FitSwap AI - Environment Configuration

# Current runtime environment: 'development' | 'production' | 'test'
NODE_ENV=development

# Testing Mode: When true, allows test workflows and live previewing with watermarked test generations
# Set to false in production once real API keys are funded and configured
NEXT_PUBLIC_TESTING_MODE=true

# AI Provider Selection: 'gemini' | 'fal' | 'replicate' | 'testing'
# Default in development: 'testing' (works out-of-the-box with simulated generation and canvas watermarking)
# Change to 'gemini', 'fal', or 'replicate' after supplying the respective API key below.
FITSWAP_AI_PROVIDER=testing

# 1. Google Gemini API (Recommended for Imagen 3 & Multimodal editing)
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Fal.ai API (For IDM-VTON, CatVTON, and specialized virtual try-on models)
# Get your key at: https://fal.ai/
FAL_KEY=your_fal_key_here

# 3. Replicate API (For IDM-VTON or SDXL inpainting virtual try-on)
# Get your key at: https://replicate.com/
REPLICATE_API_TOKEN=your_replicate_token_here

# Upload & Rate Limits
MAX_UPLOAD_SIZE_MB=15
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp
RATE_LIMIT_REQUESTS_PER_MINUTE=20
